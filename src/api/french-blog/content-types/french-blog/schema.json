{
  "kind": "collectionType",
  "collectionName": "french_blogs",
  "info": {
    "singularName": "french-blog",
    "pluralName": "french-blogs",
    "displayName": "French-blog"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "excerpt": {
      "type": "string"
    },
    "body": {
      "type": "richtext",
      "required": true
    },
    "date": {
      "type": "datetime"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "HeadingSection": {
      "type": "component",
      "component": "page-elements.hero",
      "repeatable": false
    }
  }
}
