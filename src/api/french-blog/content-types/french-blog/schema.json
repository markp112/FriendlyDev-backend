{
  "kind": "collectionType",
  "collectionName": "french_blogs",
  "info": {
    "singularName": "french-blog",
    "pluralName": "french-blogs",
    "displayName": "French-blog"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "excerpt": {
      "type": "string"
    },
    "date": {
      "type": "datetime"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "grammar.pronoun-table",
        "grammar.pronoun-row",
        "page-elements.rich-text",
        "page-elements.paragraph-with-list",
        "page-elements.paragraph-with-title",
        "page-elements.image-with-caption"
      ]
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "Grammar",
        "Vocabulary"
      ]
    }
  }
}
